---
import "../styles/global.css";
import { SEO } from "astro-seo";
interface Props {
	title?: string;
	image?: string;
}

const {
	title = "AllMaciente",
	image = "https://allmaciente.dev.br/oldPc.webp",
} = Astro.props;
---

<!doctype html>
<html lang="pt-br">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="google-site-verification"
			content="L98P0qm5pObKpf5mJZ5ZVyi9rqfEoXa7thLMievsE2A"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<SEO
			title={title}
			titleTemplate="%s | Allmaciente"
			titleDefault="Allmaciente"
			canonical={Astro.url.href}
			openGraph={{
				basic: {
					title: title,
					type: "website",
					image: image,
					url: Astro.url.href,
				},
				image: {
					alt: "Capa representativa da página",
				},
			}}
		/>
	</head>
	<body class="bg-bg-500 text-text font-jetbrains-mono">
		<slot />
	</body>
</html>
